# =========================================================
# AI DBA Operations Platform V2 — Environment Template
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# =========================================================

# ---------------------------------------------------------
# MULTI-DATABASE TARGETS
# Add one block per SQL Server instance.
# Alias must match what agents use (e.g. DB_ALIAS: PROD_01
# in Jira ticket description).
# ---------------------------------------------------------

# Primary production server
DB_PROD_01_SERVER=prod-sql-01.company.local
DB_PROD_01_DATABASE=OperationsDB
DB_PROD_01_USERNAME=sa_monitor
DB_PROD_01_PASSWORD=SecurePassword123!
DB_PROD_01_DESCRIPTION=Primary Production SQL Server

# Secondary / DR server
DB_PROD_02_SERVER=prod-sql-02.company.local
DB_PROD_02_DATABASE=OperationsDB
DB_PROD_02_USERNAME=sa_monitor
DB_PROD_02_PASSWORD=SecurePassword123!
DB_PROD_02_DESCRIPTION=Secondary Production SQL Server

# Dev / test (optional)
DB_DEV_01_SERVER=dev-sql-01.company.local
DB_DEV_01_DATABASE=DevDB
DB_DEV_01_USERNAME=sa_dev
DB_DEV_01_PASSWORD=DevPassword!
DB_DEV_01_DESCRIPTION=Development SQL Server

# ---------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...your-openrouter-or-openai-key...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------
# JIRA INTEGRATION
# ---------------------------------------------------------
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USERNAME=dba-bot@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=DBA
JIRA_ISSUE_TYPE=Task
# Label used to filter DBA tickets in JQL
JIRA_POLL_LABEL=dba-ops

# ---------------------------------------------------------
# MS TEAMS NOTIFICATIONS
# Create an Incoming Webhook in a Teams channel and paste
# the URL here.
# ---------------------------------------------------------
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ---------------------------------------------------------
# EMAIL / SMTP
# ---------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=dba-alerts@yourcompany.com
SMTP_PASSWORD=EmailPassword!
SMTP_FROM=dba-alerts@yourcompany.com
SMTP_TO=dba-team@yourcompany.com,lead-dba@yourcompany.com
SMTP_USE_TLS=true

# ---------------------------------------------------------
# HITL CALLBACK URLS
# These are embedded in Teams cards and emails.
# Must be publicly reachable (use ngrok for local dev).
# ---------------------------------------------------------
HITL_APPROVE_URL=http://localhost:8000/hitl/approve
HITL_DENY_URL=http://localhost:8000/hitl/deny

# ---------------------------------------------------------
# MCP SERVER
# ---------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=9000

# ---------------------------------------------------------
# MAIN API SERVER
# ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------
# GOVERNANCE / STORAGE
# ---------------------------------------------------------
HITL_TIMEOUT_SECONDS=3600
APPROVAL_STORE_PATH=data/approvals.json
AUDIT_LOG_PATH=data/audit.log
